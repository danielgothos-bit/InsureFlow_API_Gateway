# Copia este archivo como .env y completa los valores. NUNCA subas el .env al repositorio.
# En Render estas variables se configuran en Environment; en GitHub los secretos van en Settings -> Secrets.
ADJUSTER_SERVICE_URL=https://otro-servicio.onrender.com
ADMIN_PASSWORD=cambia-esto   # contraseña del administrador inicial
ADMIN_USERNAME=admin
ANALYTICS_SERVICE_URL=https://otro-servicio.onrender.com
CLAIMS_SERVICE_URL=https://otro-servicio.onrender.com
CORS_ALLOWED_ORIGINS=http://localhost:5173   # orígenes permitidos (o *)
DATABASE_URL=postgresql://usuario:clave@host:5432/base   # cadena de conexión de PostgreSQL
DEBUG=0
DOCUMENT_SERVICE_URL=https://otro-servicio.onrender.com
JWT_SECRET=cambia-esto   # clave para firmar los JWT
NOTIFICATION_SERVICE_URL=https://otro-servicio.onrender.com
PAYMENT_SERVICE_URL=https://otro-servicio.onrender.com
POLICYHOLDER_SERVICE_URL=https://otro-servicio.onrender.com
POLICY_SERVICE_URL=https://otro-servicio.onrender.com

# Solo para correr sin PostgreSQL ni Redis (pruebas locales):
# USE_SQLITE=1
# CELERY_EAGER=1
